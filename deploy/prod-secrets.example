apiVersion: v1
kind: Secret
metadata:
  name: mysql
  namespace: payment-gateway-prod
stringData:
  root-password: CHANGE_ME_openssl_rand_hex_16
  gateway-password: CHANGE_ME_openssl_rand_hex_16
---
apiVersion: v1
kind: Secret
metadata:
  name: gateway
  namespace: payment-gateway-prod
stringData:
  database-url: mysql://gateway:CHANGE_ME@mysql:3306/gateway
  admin-token: CHANGE_ME_openssl_rand_hex_24
  encryption-key: CHANGE_ME_openssl_rand_hex_32
  metrics-token: CHANGE_ME_openssl_rand_hex_24
  smtp-url: smtp://no-reply%40apexstrata.ie:CHANGE_ME@o-0.mx:587?tls=required
---
apiVersion: v1
kind: Secret
metadata:
  name: payment-gateway-backup
  namespace: payment-gateway-prod
stringData:
  db-user: gateway
  db-password: CHANGE_ME_same_as_mysql_gateway_password
  restic-repository: s3:https://s3.us-west-002.backblazeb2.com/k8s-axst/payment-gateway-prod
  restic-password: CHANGE_ME_openssl_rand_hex_24
  aws-access-key-id: CHANGE_ME
  aws-secret-access-key: CHANGE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: lnd
  namespace: payment-gateway-prod
stringData:
  tls.cert: CHANGE_ME_pem_from_yalr_lnd_secret
  gateway.macaroon: CHANGE_ME_binary_see_scripts_prod_bake_lnd_macaroon_sh
