{
  "components": {
    "schemas": {
      "CreateAttempt": {
        "properties": {
          "method": {
            "type": "string"
          },
          "option": {
            "type": "string"
          },
          "save_method": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "CreatePayment": {
        "description": "Send amount, or line_items to have the server compute it. With line_items, amount and tax are optional and must equal the computed values when sent.",
        "properties": {
          "amount": {
            "description": "Minor units. Optional with line_items.",
            "type": "integer"
          },
          "cancel_url": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "customer_email": {
            "type": "string"
          },
          "customer_ref": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "discount": {
            "$ref": "#/components/schemas/DiscountInput"
          },
          "line_items": {
            "items": {
              "$ref": "#/components/schemas/LineItemInput"
            },
            "maxItems": 100,
            "type": "array"
          },
          "metadata": {
            "type": "object"
          },
          "methods": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "reference": {
            "description": "Optional. Your own identifier.",
            "type": "string"
          },
          "success_url": {
            "type": "string"
          },
          "tax": {
            "type": "integer"
          }
        },
        "required": [
          "currency"
        ],
        "type": "object"
      },
      "DiscountInput": {
        "description": "Exactly one of amount or percent.",
        "properties": {
          "amount": {
            "description": "Minor units",
            "type": "integer"
          },
          "code": {
            "maxLength": 64,
            "type": "string"
          },
          "percent": {
            "description": "0 to 100, at most 2 decimals. Rounded half up on the subtotal.",
            "type": "number"
          }
        },
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "description": "Message string. Stays a string throughout /v1. In /v2 this key becomes the object now found in error_detail and the string moves to a deprecated error_message for one release. Read error_detail.code in new code.",
            "type": "string"
          },
          "error_detail": {
            "properties": {
              "code": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "EventType": {
        "description": "Webhook and /v1/events types. Endpoint filters accept these, a prefix wildcard such as withdrawal.*, or *. withdrawal.* events carry data.withdrawal instead of data.payment.",
        "enum": [
          "payment.paid",
          "payment.expired",
          "payment.cancelled",
          "payment.late_payment",
          "attempt.failed",
          "refund.completed",
          "refund.failed",
          "payment.disputed",
          "payment.dispute_closed",
          "withdrawal.requested",
          "withdrawal.completed",
          "withdrawal.failed"
        ],
        "type": "string"
      },
      "LineItem": {
        "properties": {
          "amount": {
            "description": "quantity times unit_amount",
            "type": "integer"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "discount": {
            "description": "This line's share of the discount",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "sku": {
            "type": [
              "string",
              "null"
            ]
          },
          "tax": {
            "type": "integer"
          },
          "tax_rate": {
            "type": [
              "number",
              "null"
            ]
          },
          "total": {
            "description": "amount minus discount plus tax",
            "type": "integer"
          },
          "unit_amount": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "LineItemInput": {
        "properties": {
          "description": {
            "maxLength": 255,
            "type": "string"
          },
          "name": {
            "maxLength": 127,
            "type": "string"
          },
          "quantity": {
            "default": 1,
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer"
          },
          "sku": {
            "maxLength": 64,
            "type": "string"
          },
          "tax_amount": {
            "description": "Minor units. Exclusive with tax_rate.",
            "type": "integer"
          },
          "tax_rate": {
            "description": "Percent, 0 to 100, at most 2 decimals. Exclusive with tax_amount.",
            "type": "number"
          },
          "unit_amount": {
            "description": "Minor units",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "unit_amount"
        ],
        "type": "object"
      },
      "Payment": {
        "description": "Payment view, also the webhook data.payment object.",
        "properties": {
          "amount": {
            "description": "Total in minor units: subtotal minus discount plus tax",
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "discount": {
            "properties": {
              "amount": {
                "type": "integer"
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "percent": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "dispute_status": {
            "description": "Latest dispute state, null when the payment was never disputed.",
            "enum": [
              "open",
              "won",
              "lost",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "disputed": {
            "default": false,
            "description": "True while a chargeback or dispute is open. The status itself does not change.",
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "line_items": {
            "items": {
              "$ref": "#/components/schemas/LineItem"
            },
            "type": "array"
          },
          "pay_url": {
            "type": "string"
          },
          "receipt_url": {
            "description": "Public HTML receipt, available once paid",
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "subtotal": {
            "description": "Sum of line amounts, null without line items",
            "type": [
              "integer",
              "null"
            ]
          },
          "tax": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ProviderTestResult": {
        "properties": {
          "message": {
            "description": "Fixed success text or a sanitized error. Never contains credentials.",
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "message"
        ],
        "type": "object"
      },
      "ProviderType": {
        "description": "method/provider_type pairs a project can configure in the console. Config fields per type are in the README.",
        "enum": [
          "lightning/lnd",
          "onchain/lnd",
          "stripe/stripe",
          "revolut/revolut",
          "paypal/paypal",
          "fixedfloat/fixedfloat"
        ],
        "type": "string"
      },
      "RefundInput": {
        "properties": {
          "amount": {
            "description": "Minor units. Omit for the full remaining amount.",
            "type": "integer"
          },
          "destination": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "Project API key. Keys carry scopes: payments:write, payments:read, refunds:write, saved:write, admin.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Changes inside /v1 are additive. Breaking changes ship under a new version prefix. See docs/CHANGELOG.md.",
    "title": "Payment gateway API",
    "version": "1.0.0"
  },
